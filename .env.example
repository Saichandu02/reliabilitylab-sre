# Copy to .env for local runs. No secrets belong in this file or in Git.
DATABASE_PATH=data/orders.db        # SQLite file for the Docker-free local path
BUILD_VERSION=0.1.0                 # reported by /api/status and app_build_info
# Fault injection. Leave false everywhere except a clearly named local
# lab environment. Never enable on a publicly reachable deployment.
RELIABILITYLAB_LAB_MODE=false
LAB_TOKEN=                          # optional; if set, /lab/* requires header X-Lab-Token
POSTGRES_PASSWORD=                  # docker-compose only, local value
GRAFANA_ADMIN_PASSWORD=             # docker-compose only, local value
